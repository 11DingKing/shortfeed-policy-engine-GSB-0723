# Copy to .env and adjust. All variables are prefixed with SPE_.

# Async SQLAlchemy DSN. PostgreSQL in production:
# SPE_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/spe
SPE_DATABASE_URL=sqlite+aiosqlite:///./spe.db

# Log emitted SQL (development aid).
SPE_ECHO_SQL=false

# Max watch-time (seconds) credited by a single heartbeat interval.
SPE_HEARTBEAT_MAX_GAP_SECONDS=90
